# --- EyeLab .gitignore ---
# Last revised: 2026-05-09

# Documents with sensitive information or not relevant for the public repo
.docs
.claude

# Python virtualenv & bytecode
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo

# Python build artifacts (for the portable distribution work in Phase 1A)
build/
dist/
*.egg-info/

# Generated files (per-user / per-run)
python/markers/
python/config/camera_params.yaml
python/screenshot_*.png
*.mp4

# Runtime logs
python/.logs/
.logs/

# Unity (in case the Unity project ever moves into this repo)
# These are auto-generated by Unity; never commit.
**/Library/
**/Temp/
**/Obj/
**/Logs/
**/UserSettings/
**/MemoryCaptures/
**/[Bb]uild/
**/[Bb]uilds/
**/empty_build/
**/*.csproj
**/*.unityproj
**/*.sln
**/*.slnx
**/*.suo
**/*.tmp
**/*.user
**/*.userprefs
**/*.pidb
**/*.booproj
**/*.svd
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db
**/sysinfo.txt
**/*.apk
**/*.aab
**/*.unitypackage

# Local vendor SDKs
# XREAL's SDK is publicly downloadable, but the package contains no license
# file granting redistribution of modified SDK binaries. Keep the SDK local
# and apply any local compatibility fixes via tools/patch_xreal_sdk.ps1.
eyelab_xreal/Packages/com.xreal.xr/

# IDE / editor scratch
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Backup
*.bak
*~
